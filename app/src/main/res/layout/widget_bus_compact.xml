<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bus_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/widget_bus_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="武侯 ↔ 航空港"
        android:textColor="#101828"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_bus_direction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="武侯校区 → 航空港"
        android:textColor="#667085"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_bus_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:includeFontPadding="false"
        android:text="17:20"
        android:textColor="#0C5B8C"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_bus_daytype"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="下一班 · 工作日"
        android:textColor="#667085"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_bus_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="今日已收班"
        android:textColor="#667085"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_bus_following"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="之后 18:10 · 21:40"
        android:textColor="#475467"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_bus_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="点击查看完整时刻"
        android:textColor="#98A2B3"
        android:textSize="8sp" />
</LinearLayout>
